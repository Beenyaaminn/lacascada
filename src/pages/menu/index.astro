---
import Layout from '../../layouts/Layout.astro';

const piso = Astro.url.searchParams.get('piso') || '1';
const mesa = Astro.url.searchParams.get('mesa') || '1';
const mesaInfo = `Piso ${piso} - Mesa ${mesa}`;
---
<Layout title={`Menú Digital - ${mesaInfo}`} description="Carta digital de La Cascada. Realiza tu pedido desde la mesa.">
  <main
    id="menu-app"
    data-piso={piso}
    data-mesa={mesa}
    class="min-h-screen bg-gray-50"
  ></main>

  <script>
    import { mount } from 'svelte';
    import MenuApp from '../../components/MenuApp.svelte';

    const el = document.getElementById('menu-app');
    if (el) {
      mount(MenuApp, {
        target: el,
        props: {
          piso: parseInt(el.dataset.piso || '1'),
          mesa: parseInt(el.dataset.mesa || '1'),
        },
      });
    }
  </script>
</Layout>
