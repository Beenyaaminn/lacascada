---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Iniciar Sesión — La Cascada">
  <main class="login-page">
    <!-- Food background image -->
    <div class="bg-image"></div>
    <div class="bg-overlay"></div>

    <!-- Ambient glows -->
    <div class="ambient-light light-1"></div>
    <div class="ambient-light light-2"></div>

    <!-- Main content -->
    <div class="login-wrapper">
      <!-- Logo + Branding -->
      <div class="brand-section animate-fade-in">
        <div class="logo-container">
          <img src="/lacascadapro.png" alt="La Cascada" class="logo-image" />
          <div class="logo-ring"></div>
        </div>
        <div class="brand-text">
          <h1 class="brand-name">La Cascada</h1>
          <div class="brand-divider">
            <span class="divider-line"></span>
            <span class="brand-subtitle">Sistema de Gestión</span>
            <span class="divider-line"></span>
          </div>
        </div>
      </div>

      <!-- Login Card -->
      <div class="login-card gold-border animate-fade-in-up delay-200">
        <div class="card-header">
          <h2 class="card-title">Bienvenido</h2>
          <p class="card-subtitle">Ingresa tus credenciales al panel</p>
        </div>

        <form id="login-form" class="login-form">
          <!-- Email field -->
          <div class="field-group">
            <label for="login" class="field-label">Usuario o correo</label>
            <div class="field-wrapper">
              <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
              </svg>
              <input type="text" id="login" name="login" required
                class="admin-input"
                placeholder="admin@lacascada.cl"
                autocomplete="username"
              />
            </div>
          </div>

          <!-- Password field -->
          <div class="field-group">
            <label for="password" class="field-label">Contraseña</label>
            <div class="field-wrapper">
              <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
              </svg>
              <input type="password" id="password" name="password" required
                class="admin-input"
                placeholder="••••••••"
                autocomplete="current-password"
              />
              <button type="button" id="toggle-password" class="toggle-btn" aria-label="Mostrar contraseña">
                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                  <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <svg class="eye-off-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Error message -->
          <div id="error-message" class="error-message hidden">
            <svg class="error-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
            </svg>
            <span id="error-text"></span>
          </div>

          <!-- Submit button -->
          <button type="submit" id="submit-btn" class="submit-btn">
            <span id="btn-text" class="btn-content">
              <span>Iniciar Sesión</span>
              <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
              </svg>
            </span>
            <span id="btn-loading" class="btn-loading hidden">
              <svg class="spinner" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" opacity="0.25"/>
                <path d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor" opacity="0.75"/>
              </svg>
              <span>Ingresando...</span>
            </span>
          </button>
        </form>

        <!-- Decorative bottom -->
        <div class="card-footer">
          <div class="footer-line"></div>
          <span class="footer-text">Acceso exclusivo para personal autorizado</span>
          <div class="footer-line"></div>
        </div>
      </div>

      <!-- Copyright -->
      <p class="copyright animate-fade-in delay-400">&copy; {new Date().getFullYear()} La Cascada &middot; Est. 2014</p>
    </div>
  </main>

  <script>
    // Password toggle
    const toggleBtn = document.getElementById('toggle-password');
    const eyeIcon = toggleBtn?.querySelector('.eye-icon');
    const eyeOffIcon = toggleBtn?.querySelector('.eye-off-icon');
    toggleBtn?.addEventListener('click', () => {
      const p = document.getElementById('password') as HTMLInputElement;
      const isPassword = p.type === 'password';
      p.type = isPassword ? 'text' : 'password';
      eyeIcon?.classList.toggle('hidden');
      eyeOffIcon?.classList.toggle('hidden');
    });

    // Form submission
    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorDiv = document.getElementById('error-message');
    const errorText = document.getElementById('error-text');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text');
    const btnLoading = document.getElementById('btn-loading');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorDiv?.classList.add('hidden');
      submitBtn.disabled = true;
      btnText?.classList.add('hidden');
      btnLoading?.classList.remove('hidden');
      btnLoading?.classList.add('flex');

      const formData = new FormData(form);
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ login: formData.get('login'), password: formData.get('password') }),
        });
        const json = await res.json();
        if (!res.ok) {
          if (errorText) errorText.textContent = json.error || 'Error al iniciar sesión';
          errorDiv?.classList.remove('hidden');
          submitBtn.disabled = false;
          btnText?.classList.remove('hidden');
          btnLoading?.classList.add('hidden');
          btnLoading?.classList.remove('flex');
          return;
        }
        window.location.href = json.redirect || '/admin';
      } catch {
        if (errorText) errorText.textContent = 'Error de conexión. Intenta de nuevo.';
        errorDiv?.classList.remove('hidden');
        submitBtn.disabled = false;
        btnText?.classList.remove('hidden');
        btnLoading?.classList.add('hidden');
        btnLoading?.classList.remove('flex');
      }
    });
  </script>
</Layout>

<style>
  .login-page {
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: #0a0a0f;
    padding: 24px;
  }

  /* Food background */
  .bg-image {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1920&q=80');
    background-size: cover;
    background-position: center;
    z-index: 0;
    animation: bg-zoom 30s ease-in-out infinite alternate;
  }
  @keyframes bg-zoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.08); }
  }
  .bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10,10,15,0.82) 0%,
      rgba(10,10,15,0.88) 40%,
      rgba(10,10,15,0.92) 100%
    );
    z-index: 1;
  }

  /* Ambient lights */
  .ambient-light {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(100px);
    z-index: 0;
  }
  .light-1 {
    width: 600px; height: 600px;
    top: -15%; left: -15%;
    background: radial-gradient(circle, rgba(201,169,110,0.07) 0%, transparent 70%);
    animation: float-slow 25s ease-in-out infinite;
  }
  .light-2 {
    width: 500px; height: 500px;
    bottom: -10%; right: -10%;
    background: radial-gradient(circle, rgba(201,169,110,0.05) 0%, transparent 70%);
    animation: float-slow 30s ease-in-out infinite reverse;
  }

  /* Wrapper */
  .login-wrapper {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  /* Brand */
  .brand-section {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .logo-container {
    position: relative;
    width: 100px;
    height: 100px;
  }
  .logo-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 8px 32px rgba(201,169,110,0.2));
  }
  .logo-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid rgba(201,169,110,0.15);
    animation: pulse-gold 3s ease-in-out infinite;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--admin-text);
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }
  .brand-divider {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--admin-gold-dim), transparent);
  }
  .brand-subtitle {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--admin-gold);
  }

  /* Login Card */
  .login-card {
    width: 100%;
    padding: 36px 32px;
    border-radius: 20px;
    background: rgba(17, 17, 24, 0.7);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    box-shadow: 0 24px 64px rgba(0,0,0,0.5), 0 0 0 1px rgba(201,169,110,0.05);
  }

  .card-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--admin-text);
    margin: 0 0 6px;
  }
  .card-subtitle {
    font-size: 0.875rem;
    color: var(--admin-text-dim);
    margin: 0;
  }

  /* Form */
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--admin-gold);
    padding-left: 4px;
  }
  .field-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .field-icon {
    position: absolute;
    left: 16px;
    width: 20px;
    height: 20px;
    color: var(--admin-text-dim);
    pointer-events: none;
    transition: color 0.3s;
    z-index: 2;
  }
  .field-wrapper:focus-within .field-icon {
    color: var(--admin-gold);
  }

  .toggle-btn {
    position: absolute;
    right: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: none;
    background: transparent;
    color: var(--admin-text-dim);
    cursor: pointer;
    transition: all 0.2s;
  }
  .toggle-btn:hover {
    background: rgba(201,169,110,0.06);
    color: var(--admin-text-muted);
  }
  .toggle-btn svg {
    width: 20px;
    height: 20px;
  }

  /* Error */
  .error-message {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--admin-error-dim);
    border: 1px solid rgba(196, 60, 60, 0.15);
    color: #fca5a5;
    font-size: 0.875rem;
  }
  .error-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  /* Submit Button */
  .submit-btn {
    width: 100%;
    padding: 16px 24px;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    position: relative;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    background: linear-gradient(135deg, var(--admin-gold) 0%, #b8942e 100%);
    color: #0a0a0f;
    box-shadow: 0 4px 24px rgba(201,169,110,0.2), 0 0 0 1px rgba(201,169,110,0.1);
    margin-top: 4px;
  }
  .submit-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(201,169,110,0.3), 0 0 0 1px rgba(201,169,110,0.2);
  }
  .submit-btn:hover::before { opacity: 1; }
  .submit-btn:active { transform: translateY(0); }
  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .btn-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .btn-arrow {
    width: 20px;
    height: 20px;
    transition: transform 0.3s;
  }
  .submit-btn:hover .btn-arrow {
    transform: translateX(4px);
  }
  .btn-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .spinner {
    width: 20px;
    height: 20px;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Footer */
  .card-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    padding-top: 20px;
  }
  .footer-line {
    flex: 1;
    height: 1px;
    background: var(--admin-border);
  }
  .footer-text {
    font-size: 0.6875rem;
    color: var(--admin-text-dim);
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  /* Copyright */
  .copyright {
    font-size: 0.75rem;
    color: var(--admin-text-dim);
    text-align: center;
    margin: 0;
  }

  .hidden { display: none !important; }

  /* Mobile */
  @media (max-width: 480px) {
    .login-card { padding: 28px 20px; }
    .brand-name { font-size: 2rem; }
    .logo-container { width: 80px; height: 80px; }
  }
</style>
