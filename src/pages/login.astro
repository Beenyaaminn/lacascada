---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Iniciar Sesión — La Cascada">
  <main class="min-h-[90vh] flex items-center justify-center p-4 relative overflow-hidden" style="background: linear-gradient(160deg, #102F34 0%, #1B4E56 40%, #102F34 100%);">

    <!-- Subtle pattern overlay -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(92,154,160,0.3) 2px, rgba(92,154,160,0.3) 3px), repeating-linear-gradient(0deg, transparent, transparent 8px, rgba(92,154,160,0.15) 8px, rgba(92,154,160,0.15) 9px);"></div>

    <!-- Warm glows -->
    <div class="absolute top-1/4 -left-20 w-80 h-80 rounded-full opacity-[0.08] pointer-events-none" style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%); filter: blur(60px);"></div>
    <div class="absolute bottom-1/4 -right-20 w-96 h-96 rounded-full opacity-[0.06] pointer-events-none" style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%); filter: blur(70px);"></div>

    <!-- Container -->
    <div class="relative z-10 w-full max-w-md">
      <!-- Brand emblem -->
      <div class="text-center mb-8 animate-fade-in">
        <div class="inline-flex items-center justify-center mb-6">
          <div class="w-24 h-24 rounded-full flex items-center justify-center relative" style="background: linear-gradient(135deg, #3B7B84 0%, #205C66 100%); box-shadow: 0 8px 40px rgba(32, 92, 102, 0.35);">
            <div class="text-center">
              <span class="font-display text-4xl text-white font-bold leading-none">LC</span>
            </div>
            <!-- Ring around emblem -->
            <div class="absolute inset-0 rounded-full pointer-events-none" style="border: 1.5px solid rgba(92, 154, 160, 0.35); box-shadow: 0 0 0 6px rgba(16, 47, 52, 0.9), 0 0 0 7px rgba(92, 154, 160, 0.15);"></div>
          </div>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight" style="color: var(--color-surface);">La Cascada</h1>
        <div class="flex items-center justify-center gap-3 mt-3">
          <div class="h-px w-8" style="background: linear-gradient(90deg, transparent, var(--color-accent));"></div>
          <span class="text-xs tracking-[0.3em] uppercase font-semibold" style="color: var(--color-accent);">Restaurante</span>
          <div class="h-px w-8" style="background: linear-gradient(90deg, var(--color-accent), transparent);"></div>
        </div>
      </div>

      <!-- Form card (solid, no glass) -->
      <div class="rounded-2xl p-8 sm:p-10 animate-fade-in delay-200" style="background-color: rgba(16, 47, 52, 0.7); border: 1px solid rgba(92, 154, 160, 0.15); box-shadow: 0 20px 60px rgba(0,0,0,0.5);">
        <h2 class="font-display text-2xl text-center mb-1" style="color: var(--color-surface);">Bienvenido</h2>
        <p class="text-center text-sm mb-7" style="color: var(--color-text-muted);">Accede al panel de administración</p>

        <form id="login-form" class="space-y-5">
          <div>
            <label for="login" class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--color-accent);">Usuario o correo</label>
            <div class="relative">
              <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none" style="color: #8AA6AA;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <input type="text" id="login" name="login" required
                class="w-full pl-10 pr-4 py-3 rounded-xl text-sm outline-none transition-all duration-300"
                style="background-color: rgba(255,255,255,0.06); border: 1.5px solid rgba(92,154,160,0.25); color: var(--color-surface); font-family: var(--font-body);"
                placeholder="Tu nombre o correo"
                autocomplete="username"
                onfocus="this.style.borderColor='#5C9AA0';this.style.boxShadow='0 0 0 3px rgba(92,154,160,0.15)'"
                onblur="this.style.borderColor='rgba(92,154,160,0.25)';this.style.boxShadow='none'"
              />
            </div>
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--color-accent);">Contraseña</label>
            <div class="relative">
              <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none" style="color: #8AA6AA;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              <input type="password" id="password" name="password" required
                class="w-full pl-10 pr-12 py-3 rounded-xl text-sm outline-none transition-all duration-300"
                style="background-color: rgba(255,255,255,0.06); border: 1.5px solid rgba(92,154,160,0.25); color: var(--color-surface); font-family: var(--font-body);"
                placeholder="••••••••"
                autocomplete="current-password"
                onfocus="this.style.borderColor='#5C9AA0';this.style.boxShadow='0 0 0 3px rgba(92,154,160,0.15)'"
                onblur="this.style.borderColor='rgba(92,154,160,0.25)';this.style.boxShadow='none'"
              />
              <button type="button" onclick="const p=document.getElementById('password');p.type=p.type==='password'?'text':'password';this.querySelector('svg').style.opacity=p.type==='password'?'1':'0.4'" class="absolute right-3 top-1/2 -translate-y-1/2 transition-opacity" style="color: #8AA6AA;">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </button>
            </div>
          </div>

          <div id="error-message" class="hidden text-sm text-center rounded-lg py-2.5 px-4" style="background-color: rgba(166,61,61,0.15); color: #f5b5b5;"></div>

          <button type="submit" id="submit-btn"
            class="w-full py-3.5 rounded-xl font-bold text-base shadow-lg transition-all duration-300 disabled:opacity-70 disabled:cursor-wait mt-2"
            style="background: linear-gradient(135deg, #2E7080 0%, #205C66 100%); color: #fff; box-shadow: 0 4px 20px rgba(32,92,102,0.4);"
            onmouseover="this.style.transform='translateY(-1px)';this.style.boxShadow='0 6px 24px rgba(32,92,102,0.5)'"
            onmouseout="this.style.transform='';this.style.boxShadow='0 4px 20px rgba(32,92,102,0.4)'"
          >
            <span id="btn-text">Iniciar Sesión</span>
            <span id="btn-loading" class="hidden items-center justify-center gap-2">
              <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
              Ingresando&hellip;
            </span>
          </button>
        </form>
      </div>

      <!-- Footer hint -->
      <p class="text-center text-xs mt-6 animate-fade-in delay-300" style="color: #52737A;">&copy; {new Date().getFullYear()} La Cascada &middot; Est. 2014</p>
    </div>
  </main>

  <script>
    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorDiv = document.getElementById('error-message') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement;
    const btnLoading = document.getElementById('btn-loading') as HTMLSpanElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorDiv.classList.add('hidden');
      submitBtn.disabled = true;
      btnText.classList.add('hidden');
      btnLoading.classList.remove('hidden');
      btnLoading.classList.add('inline-flex');

      const formData = new FormData(form);
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ login: formData.get('login'), password: formData.get('password') }),
        });
        const json = await res.json();
        if (!res.ok) {
          errorDiv.textContent = json.error || 'Error al iniciar sesión';
          errorDiv.classList.remove('hidden');
          submitBtn.disabled = false;
          btnText.classList.remove('hidden');
          btnLoading.classList.add('hidden');
          btnLoading.classList.remove('inline-flex');
          return;
        }
        window.location.href = json.redirect || '/admin';
      } catch {
        errorDiv.textContent = 'Error de conexión. Intenta de nuevo.';
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        btnText.classList.remove('hidden');
        btnLoading.classList.add('hidden');
        btnLoading.classList.remove('inline-flex');
      }
    });
  </script>
</Layout>
