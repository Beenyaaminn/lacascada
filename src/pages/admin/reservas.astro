---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionFromCookie } from '../../lib/auth';

const cookieHeader = Astro.request.headers.get('cookie');
const session = getSessionFromCookie(cookieHeader);

if (!session || (session.rol !== 'admin' && session.rol !== 'garzon')) {
  return Astro.redirect('/login');
}
---
<AdminLayout title="Reservas - La Cascada" currentPage="/admin/reservas">
  <div id="reservas-app" class="h-full"></div>
</AdminLayout>

<script>
  import { mount } from 'svelte';
  import ReservasAdmin from '../../components/ReservasAdmin.svelte';
  const el = document.getElementById('reservas-app');
  if (el) mount(ReservasAdmin, { target: el });
</script>
