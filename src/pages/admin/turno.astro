---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionFromCookie } from '../../lib/auth';

const cookieHeader = Astro.request.headers.get('cookie');
const session = getSessionFromCookie(cookieHeader);

if (!session || (session.rol !== 'admin' && session.rol !== 'garzon')) {
  return Astro.redirect('/login');
}
---
<AdminLayout title="Turnos - La Cascada" currentPage="/admin/turno">
  <div id="turno-app" class="h-full"></div>
  <script>
    import { mount } from 'svelte';
    import TurnoAdmin from '../../components/TurnoAdmin.svelte';
    const el = document.getElementById('turno-app');
    if (el) mount(TurnoAdmin, { target: el });
  </script>
</AdminLayout>
