---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionFromCookie } from '../../lib/auth';
import { sql } from '../../lib/db';

const cookieHeader = Astro.request.headers.get('cookie');
const session = getSessionFromCookie(cookieHeader);

if (!session || (session.rol !== 'admin' && session.rol !== 'garzon')) {
  return Astro.redirect('/login');
}

const pedidoId = parseInt(Astro.url.searchParams.get('pedido_id') || '0');
let voucherData: any = null;

if (pedidoId > 0) {
  try {
    const pedido = await sql`
      SELECT p.*, m.numero_mesa, m.piso
      FROM pedidos p LEFT JOIN mesas m ON m.id = p.mesa_id
      WHERE p.id = ${pedidoId} LIMIT 1
    `;
    if (pedido.length > 0) {
      const detalles = await sql`
        SELECT dp.*, pr.nombre as producto_nombre
        FROM detalle_pedidos dp JOIN productos pr ON pr.id = dp.producto_id
        WHERE dp.pedido_id = ${pedidoId}
      `;
      const p = pedido[0];
      let mesaInfo = '';
      if (p.tipo_pedido === 'delivery') {
        mesaInfo = `Delivery - ${p.nombre_cliente || 'Cliente'}`;
      } else if (p.numero_mesa) {
        mesaInfo = `Piso ${p.piso} - Mesa ${p.numero_mesa}`;
      } else {
        mesaInfo = p.tipo_pedido || '';
      }
      const costoEnvio = p.costo_envio || 0;
      const descuento = p.descuento || 0;
      const totalFinal = (p.total || 0) - descuento;
      voucherData = {
        pedido_id: p.id,
        fecha: new Date(p.fecha_hora).toLocaleString('es-CL'),
        mesaInfo,
        metodoPago: (p.metodo_pago || '').toUpperCase().replace('_', ' '),
        total: totalFinal,
        vuelto: p.efectivo_con_cuanto > totalFinal ? (p.efectivo_con_cuanto - totalFinal) : 0,
        nombreCliente: p.nombre_cliente || '',
        direccion: p.direccion || '',
        telefono: p.telefono || '',
        efectivoConCuanto: p.efectivo_con_cuanto || 0,
        detalles: detalles.map((d: any) => {
          const sub = d.subtotal || 0;
          const acomp = d.acompanamiento || '';
          return {
            cantidad: d.cantidad,
            nombre: d.producto_nombre,
            subtotal: sub,
            acompanamiento: acomp,
          };
        }),
        costoEnvio,
      };
    }
  } catch (e) {
    console.error('Error cargando voucher:', (e as Error).message);
  }
}

const tieneVoucher = !!voucherData;
const p = voucherData;
---
<AdminLayout title={`Voucher #${pedidoId} - La Cascada`}>
  {tieneVoucher ? (
    <div style="display:flex;justify-content:center;padding:2rem 1rem 0;">
      <div class="bg-white shadow-lg rounded-lg p-6 max-w-[72mm] w-full font-mono text-xs" id="voucher-print">
        <div class="text-center mb-3">
          <p class="font-bold text-sm">LA CASCADA</p>
          <p class="text-xs text-gray-500">Restaurant - Punto de Venta</p>
        </div>
        <div class="border-t border-dashed border-gray-300 my-2"></div>
        <div class="space-y-1 mb-2 text-xs">
          <p><span class="font-semibold">FECHA:</span> {p.fecha}</p>
          <p><span class="font-semibold">PEDIDO:</span> #{p.pedido_id}</p>
          <p><span class="font-semibold">UBICACION:</span> {p.mesaInfo}</p>
          {p.nombreCliente ? <p><span class="font-semibold">CLIENTE:</span> {p.nombreCliente}</p> : null}
        </div>
        <div class="border-t border-dashed border-gray-300 my-2"></div>
        <p class="text-xs font-semibold mb-1">DETALLE:</p>
        <div class="space-y-1 mb-3">
          {p.detalles.map((d: any) => (
            <div>
              <p>{d.cantidad}x {d.nombre} <span class="float-right">${d.subtotal.toLocaleString()}</span></p>
              {d.acompanamiento && d.acompanamiento !== 'Sin acompañamiento' ? <p class="text-gray-500 ml-4 text-xs">+ {d.acompanamiento}</p> : null}
            </div>
          ))}
        </div>
        <div class="border-t border-dashed border-gray-300 my-2"></div>
        <div class="space-y-1">
          <p><span class="font-semibold">SUBTOTAL:</span> <span class="float-right">${p.total.toLocaleString()}</span></p>
          {p.costoEnvio > 0 ? <p><span class="font-semibold">ENVIO:</span> <span class="float-right">${p.costoEnvio.toLocaleString()}</span></p> : null}
          <p><span class="font-semibold">FORMA DE PAGO:</span> {p.metodoPago}</p>
        </div>
        <div class="border-t border-dashed border-gray-300 my-2"></div>
        <p class="text-center font-bold text-sm">TOTAL: ${p.total.toLocaleString()}</p>
        {p.vuelto > 0 ? <p class="text-center text-xs mt-1">VUELTO: ${p.vuelto.toLocaleString()}</p> : null}
        <div class="border-t border-dashed border-gray-300 my-2"></div>
        <p class="text-center text-xs text-gray-500">Gracias por su visita!</p>
      </div>
    </div>
  ) : (
    <p class="text-center text-gray-500 py-8">Voucher no encontrado</p>
  )}
  <div class="text-center pt-6 pb-8">
    {tieneVoucher ? <button onclick="window.print()" class="btn-primary">Imprimir Voucher</button> : null}
    <a href="/admin/pedidos" class="btn-secondary ml-2 inline-block no-underline">Volver a Pedidos</a>
  </div>
</AdminLayout>

<style>
  @page { size: 80mm auto; margin: 0; }
  @media print {
    body * { visibility: hidden; }
    #voucher-print, #voucher-print * { visibility: visible; }
    #voucher-print { position: absolute; left: 0; top: 0; width: 72mm; font-size: 11px; padding: 4px 6px; }
  }
</style>
