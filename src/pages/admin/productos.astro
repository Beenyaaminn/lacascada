---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionFromCookie } from '../../lib/auth';

const cookieHeader = Astro.request.headers.get('cookie');
const session = getSessionFromCookie(cookieHeader);

if (!session || (session.rol !== 'admin' && session.rol !== 'garzon')) {
  return Astro.redirect('/login');
}
---
<AdminLayout title="Productos - La Cascada" currentPage="/admin/productos">
  <div id="productos-app" class="h-full"></div>
</AdminLayout>

<script>
  import { mount } from 'svelte';
  import ProductosAdmin from '../../components/ProductosAdmin.svelte';
  const el = document.getElementById('productos-app');
  if (el) mount(ProductosAdmin, { target: el });
</script>
