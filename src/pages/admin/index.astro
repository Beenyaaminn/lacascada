---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionFromCookie } from '../../lib/auth';

const cookieHeader = Astro.request.headers.get('cookie');
const session = getSessionFromCookie(cookieHeader);

if (!session) {
  return Astro.redirect('/login');
}

if (session.rol !== 'admin' && session.rol !== 'garzon') {
  return Astro.redirect('/menu');
}
---
<AdminLayout title="Panel de Administración - La Cascada" currentPage="/admin">
  <div class="p-6 sm:p-8 flex flex-col items-center justify-center min-h-[70vh]">
    <a href="/admin/mesas" class="text-center group mb-8">
      <h1 class="text-5xl md:text-6xl font-extrabold text-brand-700 group-hover:text-brand-800 transition-colors">La Cascada</h1>
      <p class="text-gray-400 mt-2 text-lg">Sistema de Punto de Venta</p>
    </a>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 w-full max-w-3xl">
      <a href="/admin/mesas" class="card hover:shadow-md transition-shadow group">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">🍽️</span>
          <h3 class="text-lg font-semibold text-gray-900 group-hover:text-brand-600">Toma de Pedidos</h3>
        </div>
        <p class="text-gray-500 text-sm">Mesas, reservas y delivery</p>
      </a>
      <a href="/admin/pedidos" class="card hover:shadow-md transition-shadow group">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">📦</span>
          <h3 class="text-lg font-semibold text-gray-900 group-hover:text-brand-600">Pedidos</h3>
        </div>
        <p class="text-gray-500 text-sm">Gestión de pedidos activos</p>
      </a>
      <a href="/admin/clientes" class="card hover:shadow-md transition-shadow group">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">👥</span>
          <h3 class="text-lg font-semibold text-gray-900 group-hover:text-brand-600">Créditos</h3>
        </div>
        <p class="text-gray-500 text-sm">Clientes con cuenta corriente</p>
      </a>
      <a href="/admin/productos" class="card hover:shadow-md transition-shadow group">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">📋</span>
          <h3 class="text-lg font-semibold text-gray-900 group-hover:text-brand-600">Productos</h3>
        </div>
        <p class="text-gray-500 text-sm">CRUD de productos, precios y stock</p>
      </a>
      <a href="/admin/reservas" class="card hover:shadow-md transition-shadow group">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">📅</span>
          <h3 class="text-lg font-semibold text-gray-900 group-hover:text-brand-600">Reservas</h3>
        </div>
        <p class="text-gray-500 text-sm">Apartado de platos del día</p>
      </a>
      <a href="/admin/reportes" class="card hover:shadow-md transition-shadow group">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">📊</span>
          <h3 class="text-lg font-semibold text-gray-900 group-hover:text-brand-600">Reportes</h3>
        </div>
        <p class="text-gray-500 text-sm">Ventas y contabilidad</p>
      </a>
    </div>
  </div>
</AdminLayout>
