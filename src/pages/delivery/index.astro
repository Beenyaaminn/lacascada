---
import Layout from '../../layouts/Layout.astro';
import { sql } from '../../lib/db';

let categorias: any[] = [];
let productos: any[] = [];
let acompanamientos: any[] = [];
let productosAcomp: any[] = [];
let menuError = false;

try {
  [categorias, productos, acompanamientos, productosAcomp] = await Promise.all([
    sql`SELECT * FROM categorias ORDER BY orden ASC`,
    sql`
      SELECT p.*, c.nombre as categoria_nombre
      FROM productos p
      JOIN categorias c ON c.id = p.categoria_id
      WHERE p.disponible_dia = TRUE
        AND (p.maneja_stock = FALSE OR p.stock_actual > 0)
      ORDER BY c.orden ASC, p.nombre ASC
    `,
    sql`SELECT * FROM acompanamientos ORDER BY es_extra ASC, nombre ASC`,
    sql`SELECT * FROM productos_acompanamientos`,
  ]);
} catch (e) {
  menuError = true;
}
---
<Layout title="Delivery - La Cascada" description="Realiza tu pedido para delivery desde La Cascada.">
  {menuError ? (
    <main style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: var(--color-background); padding: 2rem; text-align: center;">
      <div>
        <h1 style="font-family: var(--font-display); font-size: 1.5rem; color: var(--color-primary); margin-bottom: 0.5rem;">Delivery temporalmente no disponible</h1>
        <p style="color: var(--color-text-muted); font-size: 0.875rem;">Estamos teniendo problemas técnicos. Intenta en unos minutos o llámanos directamente.</p>
      </div>
    </main>
  ) : (
    <main
      id="delivery-app"
      style="min-height: 100vh; background-color: var(--color-background);"
      data-menu={JSON.stringify({ categorias, productos, acompanamientos, productos_acompanamientos: productosAcomp }).replace(/"/g, '&quot;')}
    ></main>
  )}

  <script>
    import { mount } from 'svelte';
    import DeliveryForm from '../../components/DeliveryForm.svelte';

    const el = document.getElementById('delivery-app');
    if (el) {
      try {
        const menuData = JSON.parse(el?.dataset?.menu?.replace(/&quot;/g, '"') || 'null');
        mount(DeliveryForm, {
          target: el,
          props: { menuData },
        });
      } catch (e) {
        el.innerHTML = '<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:2rem;"><div><h1 style="font-size:1.25rem;color:#205C66;margin-bottom:0.5rem;">Error al cargar</h1><p style="color:#52737A;font-size:0.875rem;">Recarga la página o intenta más tarde.</p></div></div>';
      }
    }
  </script>
</Layout>
