---
import Layout from '../layouts/Layout.astro';
---
<Layout title="La Cascada — Restaurante" description="La Cascada, Sabores que fluyen, momentos que quedan. Restaurante desde 2014. Carta digital, delivery y más.">
  <main class="relative" style="background: linear-gradient(180deg, var(--color-background) 0%, var(--color-surface-dark) 100%);">

    <!-- ── Hero ── -->
    <section class="relative min-h-[85vh] flex flex-col items-center justify-center text-center px-6 overflow-hidden">
      <!-- Gold glow top right -->
      <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full opacity-[0.10] pointer-events-none" style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"></div>
      <!-- Gold glow bottom left -->
      <div class="absolute bottom-0 left-0 w-[500px] h-[500px] rounded-full opacity-[0.08] pointer-events-none" style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"></div>
      <!-- Subtle grain -->
      <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\'40\' height=\'40\' viewBox=\'0 0 40 40\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'%232d2418\' fill-opacity=\'0.6\'%3E%3Ccircle cx=\'20\' cy=\'20\' r=\'0.6\'/%3E%3C/g%3E%3C/svg%3E');"></div>

      <!-- Badge -->
      <div class="animate-fade-in delay-100 mb-6">
        <span class="badge badge-gold text-xs px-4 py-1.5">Desde 2014</span>
      </div>

      <!-- Ornament line -->
      <div class="flex items-center gap-4 mb-8 animate-fade-in delay-200">
        <div class="h-px w-10" style="background: linear-gradient(90deg, transparent, var(--color-accent));"></div>
        <span class="font-display italic text-lg" style="color: var(--color-accent);">Restaurante</span>
        <div class="h-px w-10" style="background: linear-gradient(90deg, var(--color-accent), transparent);"></div>
      </div>

      <!-- Title -->
      <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[1.05] mb-6 animate-fade-in delay-300 max-w-4xl">
        <span style="color: var(--color-primary);">La Cascada,</span><br/>
        <span class="italic" style="color: var(--color-accent);">Sabores que fluyen, momentos que quedan.</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg max-w-lg mx-auto leading-relaxed mb-10 animate-fade-in delay-500" style="color: var(--color-text-muted);">
        Platos preparados al momento, ingredientes frescos y el sabor de casa. Pide desde tu mesa, tu hogar o llévatelo.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-3 animate-fade-in delay-600">
        <a href="/menu" class="btn-accent text-base px-8 py-4 rounded-full">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          Ver Carta
        </a>
        <a href="/delivery" class="btn-primary text-base px-8 py-4 rounded-full">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
          Pedir Delivery
        </a>
      </div>

      <!-- Feature pills -->
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-3 mt-12 animate-fade-in delay-700" style="color: var(--color-text-muted);">
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-accent);"></span>Carta QR en mesa
        </span>
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-accent);"></span>Delivery a domicilio
        </span>
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-accent);"></span>Pedidos al instante
        </span>
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-accent);"></span>Paga en mesa
        </span>
      </div>
    </section>

    <!-- ── Cómo funciona ── -->
    <section class="section" style="background-color: var(--color-surface);">
      <div class="container-narrow">
        <div class="text-center mb-16">
          <span class="badge badge-gold mb-4">Simple y rápido</span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold mb-3" style="color: var(--color-primary);">Así de fácil</h2>
          <p class="text-base sm:text-lg max-w-lg mx-auto" style="color: var(--color-text-muted);">Disfruta de La Cascada donde quieras, como quieras.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div class="card-elevated text-center group transition-all duration-300 hover:-translate-y-1">
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5" style="background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-hover) 100%); box-shadow: 0 4px 16px rgba(201, 162, 39, 0.25);">
              <svg class="w-7 h-7" style="color: var(--color-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2m4 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="font-display text-lg font-semibold mb-2" style="color: var(--color-primary);">Escanea el QR</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">Ubicado en tu mesa. Escanea, elige tu mesa y accede directo a la carta.</p>
          </div>

          <!-- Step 2 -->
          <div class="card-elevated text-center group transition-all duration-300 hover:-translate-y-1">
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5" style="background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-hover) 100%); box-shadow: 0 4px 16px rgba(201, 162, 39, 0.25);">
              <svg class="w-7 h-7" style="color: var(--color-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <h3 class="font-display text-lg font-semibold mb-2" style="color: var(--color-primary);">Elige tus platos</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">Explora la carta, arma tu pedido con todos los detalles. Fácil y rápido.</p>
          </div>

          <!-- Step 3 -->
          <div class="card-elevated text-center group transition-all duration-300 hover:-translate-y-1">
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5" style="background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-hover) 100%); box-shadow: 0 4px 16px rgba(201, 162, 39, 0.25);">
              <svg class="w-7 h-7" style="color: var(--color-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
            </div>
            <h3 class="font-display text-lg font-semibold mb-2" style="color: var(--color-primary);">Recibe y disfruta</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">Tu pedido llega a la mesa o a tu casa. Paga en efectivo, débito o crédito.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Servicios ── -->
    <section class="section" style="background: linear-gradient(180deg, var(--color-background) 0%, var(--color-surface-dark) 100%);">
      <div class="container-narrow">
        <div class="text-center mb-14">
          <span class="badge badge-gold mb-4">Para todos los gustos</span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold mb-3" style="color: var(--color-primary);">Estés donde estés</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <!-- En el local -->
          <a href="/menu" class="card-elevated flex gap-5 p-6 no-underline transition-all duration-300 hover:-translate-y-1 hover:shadow-lg group" style="text-decoration: none;">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background-color: var(--color-accent-light);">
              <svg class="w-6 h-6" style="color: var(--color-accent-hover);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/></svg>
            </div>
            <div class="flex-1">
              <h3 class="font-display text-lg font-semibold mb-1" style="color: var(--color-primary);">En el local</h3>
              <p class="text-sm" style="color: var(--color-text-muted);">Escanea el QR en tu mesa y pide directo. Sin filas, sin esperar al garzón.</p>
              <span class="inline-flex items-center gap-1 text-sm font-medium mt-3 transition-colors" style="color: var(--color-accent);">
                Ver carta <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>

          <!-- Delivery -->
          <a href="/delivery" class="card-elevated flex gap-5 p-6 no-underline transition-all duration-300 hover:-translate-y-1 hover:shadow-lg group" style="text-decoration: none;">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background-color: var(--color-accent-light);">
              <svg class="w-6 h-6" style="color: var(--color-accent-hover);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
            </div>
            <div class="flex-1">
              <h3 class="font-display text-lg font-semibold mb-1" style="color: var(--color-primary);">Delivery</h3>
              <p class="text-sm" style="color: var(--color-text-muted);">Pide desde casa con delivery a domicilio. Tus platos favoritos donde estés.</p>
              <span class="inline-flex items-center gap-1 text-sm font-medium mt-3 transition-colors" style="color: var(--color-accent);">
                Pedir ahora <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>

          <!-- Para llevar -->
          <div class="card-elevated flex gap-5 p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background-color: var(--color-accent-light);">
              <svg class="w-6 h-6" style="color: var(--color-accent-hover);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            </div>
            <div class="flex-1">
              <h3 class="font-display text-lg font-semibold mb-1" style="color: var(--color-primary);">Para llevar</h3>
              <p class="text-sm" style="color: var(--color-text-muted);">Pide por teléfono al <strong>+569 66937327</strong> y pasa a retirar. Rápido y cómodo.</p>
            </div>
          </div>

          <!-- Reservas -->
          <a href="/login" class="card-elevated flex gap-5 p-6 no-underline transition-all duration-300 hover:-translate-y-1 hover:shadow-lg group" style="text-decoration: none;">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background-color: var(--color-accent-light);">
              <svg class="w-6 h-6" style="color: var(--color-accent-hover);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <div class="flex-1">
              <h3 class="font-display text-lg font-semibold mb-1" style="color: var(--color-primary);">Reservas</h3>
              <p class="text-sm" style="color: var(--color-text-muted);">Asegura tu mesa. Reserva con anticipación y te esperamos con todo listo.</p>
              <span class="inline-flex items-center gap-1 text-sm font-medium mt-3 transition-colors" style="color: var(--color-accent);">
                Reservar <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ── Footer ── -->
    <footer class="py-12 px-6" style="background-color: var(--color-primary);">
      <div class="container-narrow">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full flex items-center justify-center" style="background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-hover) 100%);">
              <span class="font-display text-white font-bold text-sm">LC</span>
            </div>
            <div>
              <p class="font-display text-base font-semibold" style="color: var(--color-surface);">La Cascada</p>
              <p class="text-[10px] tracking-[0.25em] uppercase" style="color: var(--color-text-light);">Restaurante · Est. 2014</p>
            </div>
          </div>
          <div class="text-center sm:text-right">
            <p class="text-sm" style="color: var(--color-text-muted);">Rioseco #267, Lebu · +569 66937327</p>
            <p class="text-xs mt-1" style="color: var(--color-text-light);">© {new Date().getFullYear()} La Cascada. Todos los derechos reservados.</p>
          </div>
        </div>
        <!-- Ornament -->
        <div class="flex items-center gap-3 justify-center mt-8 opacity-40">
          <div class="h-px w-8" style="background: linear-gradient(90deg, transparent, var(--color-accent));"></div>
          <span class="font-display italic text-xs" style="color: var(--color-accent);">Sabores que fluyen, momentos que quedan</span>
          <div class="h-px w-8" style="background: linear-gradient(90deg, var(--color-accent), transparent);"></div>
        </div>
      </div>
    </footer>
  </main>
</Layout>
