---
import Layout from '../layouts/Layout.astro';
---
<Layout title="La Cascada — Restaurante" description="La Cascada, Sabores que fluyen, momentos que quedan. Restaurante desde 2014. Carta digital, delivery y más.">
  <main class="relative" style="background: linear-gradient(180deg, var(--color-background) 0%, var(--color-surface-dark) 100%);">

    <!-- ── Hero ── -->
    <section class="relative min-h-[85vh] flex flex-col items-center justify-center text-center px-6 overflow-hidden">
      <!-- Gold glow top right -->
      <div class="absolute top-0 right-0 w-64 sm:w-96 md:w-[500px] lg:w-[600px] h-64 sm:h-96 md:h-[500px] lg:h-[600px] rounded-full opacity-[0.10] pointer-events-none" style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"></div>
      <!-- Gold glow bottom left -->
      <div class="absolute bottom-0 left-0 w-64 sm:w-96 md:w-[400px] lg:w-[500px] h-64 sm:h-96 md:h-[400px] lg:h-[500px] rounded-full opacity-[0.08] pointer-events-none" style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"></div>
      <!-- Subtle grain -->
      <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\'40\' height=\'40\' viewBox=\'0 0 40 40\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'%232d2418\' fill-opacity=\'0.6\'%3E%3Ccircle cx=\'20\' cy=\'20\' r=\'0.6\'/%3E%3C/g%3E%3C/svg%3E');"></div>

      <!-- Badge -->
      <div class="animate-fade-in delay-100 mb-6">
        <span class="badge badge-gold text-xs px-4 py-1.5">Desde 2014</span>
      </div>

      <!-- Ornament line -->
      <div class="flex items-center gap-4 mb-8 animate-fade-in delay-200">
        <div class="h-px w-10" style="background: linear-gradient(90deg, transparent, var(--color-accent));"></div>
        <span class="font-display italic text-lg" style="color: var(--color-accent);">Restaurante</span>
        <div class="h-px w-10" style="background: linear-gradient(90deg, var(--color-accent), transparent);"></div>
      </div>

      <!-- Title -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[1.05] mb-6 animate-fade-in delay-300 max-w-4xl">
        <span style="color: var(--color-primary);">La Cascada,</span><br/>
        <span class="italic" style="color: var(--color-accent);">Sabores que fluyen, momentos que quedan.</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg max-w-lg mx-auto leading-relaxed mb-6 sm:mb-10 animate-fade-in delay-500" style="color: var(--color-text-muted);">
        Platos preparados al momento, ingredientes frescos y el sabor de casa. Pide desde tu mesa, tu hogar o llévatelo.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-3 animate-fade-in delay-600">
        <a href="/menu" class="btn-accent text-base px-8 py-4 rounded-full">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          Ver Carta
        </a>
        <a href="/delivery" class="btn-primary text-base px-8 py-4 rounded-full">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
          Pedir Delivery
        </a>
      </div>

      <!-- Feature pills -->
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-3 mt-8 sm:mt-12 animate-fade-in delay-700" style="color: var(--color-text-muted);">
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-accent);"></span>Carta QR en mesa
        </span>
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-accent);"></span>Delivery a domicilio
        </span>
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-accent);"></span>Pedidos al instante
        </span>
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-accent);"></span>Paga en mesa
        </span>
      </div>
    </section>

    <!-- ── Footer ── -->
    <footer class="py-8 sm:py-12 px-4 sm:px-6" style="background-color: var(--color-primary);">
      <div class="container-narrow">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full flex items-center justify-center" style="background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-hover) 100%);">
              <span class="font-display text-white font-bold text-sm">LC</span>
            </div>
            <div>
              <p class="font-display text-base font-semibold" style="color: var(--color-surface);">La Cascada</p>
              <p class="text-[10px] tracking-[0.25em] uppercase" style="color: var(--color-text-light);">Restaurante · Est. 2014</p>
            </div>
          </div>
          <div class="text-center sm:text-right">
            <p class="text-sm" style="color: var(--color-text-muted);">Rioseco #267, Lebu · +569 66937327</p>
            <p class="text-xs mt-1" style="color: var(--color-text-light);">© {new Date().getFullYear()} La Cascada. Todos los derechos reservados.</p>
          </div>
        </div>
        <!-- Ornament -->
        <div class="flex items-center gap-3 justify-center mt-8 opacity-40">
          <div class="h-px w-8" style="background: linear-gradient(90deg, transparent, var(--color-accent));"></div>
          <span class="font-display italic text-xs" style="color: var(--color-accent);">Sabores que fluyen, momentos que quedan</span>
          <div class="h-px w-8" style="background: linear-gradient(90deg, var(--color-accent), transparent);"></div>
        </div>
      </div>
    </footer>
  </main>
</Layout>
