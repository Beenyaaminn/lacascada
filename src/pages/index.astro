---
import Layout from '../layouts/Layout.astro';
---
<Layout title="La Cascada - Restaurante" description="Cocina honesta, sabores que quedan. La Cascada — restaurante desde 2014.">
  <main class="relative min-h-screen overflow-hidden" style="background: linear-gradient(180deg, #faf6f0 0%, #f0ebe0 100%);">

    <!-- Decorative top accent band -->
    <div class="absolute top-0 left-0 right-0 h-1 z-10" style="background: linear-gradient(90deg, transparent, #c9a227 20%, #c9a227 80%, transparent);"></div>

    <!-- Decorative gold glows -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full opacity-20 pointer-events-none" style="background: radial-gradient(circle, #c9a227 0%, transparent 70%); filter: blur(80px);"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] rounded-full opacity-15 pointer-events-none" style="background: radial-gradient(circle, #c9a227 0%, transparent 70%); filter: blur(80px);"></div>

    <!-- Subtle grain texture -->
    <div class="absolute inset-0 opacity-[0.025] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\'30\' height=\'30\' viewBox=\'0 0 30 30\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'%231a1410\' fill-opacity=\'0.8\'%3E%3Ccircle cx=\'15\' cy=\'15\' r=\'0.8\'/%3E%3C/g%3E%3C/svg%3E');"></div>

    <!-- Main content -->
    <div class="relative z-10 min-h-screen flex flex-col">

      <!-- Header / Brand mark -->
      <header class="flex items-center justify-center pt-12 pb-4 animate-fade-in" style="animation-delay:0.1s">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full flex items-center justify-center" style="background: linear-gradient(135deg, #c9a227 0%, #a8841c 100%); box-shadow: 0 4px 12px rgba(201, 162, 39, 0.3);">
            <span class="font-display text-white font-bold text-sm">LC</span>
          </div>
          <div>
            <p class="font-display text-base font-bold" style="color: #1a1410;">La Cascada</p>
            <p class="text-[10px] tracking-[0.25em] uppercase" style="color: #9b8a78;">Restaurante · Est. 2014</p>
          </div>
        </div>
      </header>

      <!-- Hero section -->
      <section class="flex-1 flex flex-col items-center justify-center text-center px-6 py-12 max-w-5xl mx-auto">
        <!-- Ornamental divider -->
        <div class="flex items-center gap-3 mb-6 animate-fade-in" style="animation-delay:0.2s">
          <div class="h-px w-12" style="background: linear-gradient(90deg, transparent, #c9a227);"></div>
          <span class="text-xs tracking-[0.3em] uppercase font-semibold" style="color: #c9a227;">Sabores que quedan</span>
          <div class="h-px w-12" style="background: linear-gradient(90deg, #c9a227, transparent);"></div>
        </div>

        <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-none mb-6 animate-fade-in" style="animation-delay:0.3s">
          <span style="color: #1a1410;">Cocina honesta,</span><br/>
          <span class="italic" style="color: #c9a227;">momentos que</span>
          <span style="color: #1a1410;">fluyen.</span>
        </h1>

        <p class="text-base sm:text-lg max-w-xl mx-auto leading-relaxed mb-12 animate-fade-in" style="animation-delay:0.5s; color: #6b5d4f;">
          Comida preparada al momento, con ingredientes frescos y recetas de siempre. Pide desde tu mesa, tu casa o llévatela.
        </p>

        <!-- CTA buttons -->
        <div class="flex flex-col sm:flex-row gap-3 mb-8 animate-fade-in" style="animation-delay:0.6s">
          <a href="/menu" class="group relative inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full font-semibold text-sm transition-all duration-300" style="background: linear-gradient(135deg, #1a1410 0%, #2d2418 100%); color: #faf6f0; box-shadow: 0 4px 16px rgba(26, 20, 16, 0.25);" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(26, 20, 16, 0.35)'" onmouseout="this.style.transform='';this.style.boxShadow='0 4px 16px rgba(26, 20, 16, 0.25)'">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            Ver Carta Digital
          </a>
          <a href="/delivery" class="group relative inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full font-semibold text-sm transition-all duration-300" style="background-color: #c9a227; color: #1a1410; box-shadow: 0 4px 16px rgba(201, 162, 39, 0.3);" onmouseover="this.style.backgroundColor='#b8922a';this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(201, 162, 39, 0.4)'" onmouseout="this.style.backgroundColor='#c9a227';this.style.transform='';this.style.boxShadow='0 4px 16px rgba(201, 162, 39, 0.3)'">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
            </svg>
            Pedir Delivery
          </a>
          <a href="/admin" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full font-semibold text-sm transition-all duration-300" style="background-color: transparent; color: #1a1410; border: 1px solid #e8e0d0;" onmouseover="this.style.backgroundColor='#fffaf2';this.style.borderColor='#c9a227'" onmouseout="this.style.backgroundColor='transparent';this.style.borderColor='#e8e0d0'">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Personal
          </a>
        </div>

        <!-- Feature pills -->
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-4 animate-fade-in" style="animation-delay:0.7s; color: #6b5d4f;">
          <span class="text-xs uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full" style="background-color: #c9a227;"></span>
            Carta QR
          </span>
          <span class="text-xs uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full" style="background-color: #c9a227;"></span>
            Delivery a domicilio
          </span>
          <span class="text-xs uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full" style="background-color: #c9a227;"></span>
            Pedidos al momento
          </span>
        </div>
      </section>

      <!-- Footer -->
      <footer class="text-center pb-6 px-6 animate-fade-in" style="animation-delay:0.9s">
        <div class="h-px w-32 mx-auto mb-4" style="background: linear-gradient(90deg, transparent, #e8e0d0, transparent);"></div>
        <p class="text-xs" style="color: #9b8a78;">© {new Date().getFullYear()} Restaurante La Cascada · Av. Principal 1234 · +56 9 1234 5678</p>
      </footer>
    </div>
  </main>
</Layout>

<style is:global>
  @keyframes fade-in { 0% { opacity: 0; transform: translateY(8px); } 100% { opacity: 1; transform: translateY(0); } }
  .animate-fade-in { opacity: 0; animation: fade-in 0.8s ease-out forwards; }
</style>
