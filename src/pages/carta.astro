---
import '../styles/global.css';
import { sql } from '../lib/db';

let porCategoria: any[] = [];
let cartaError = false;

try {
  const categorias = await sql`SELECT * FROM categorias ORDER BY orden ASC`;
  const productos = await sql`
    SELECT p.*, c.nombre as categoria_nombre
    FROM productos p
    JOIN categorias c ON c.id = p.categoria_id
    WHERE p.disponible_dia = TRUE
      AND (p.maneja_stock = FALSE OR p.stock_actual > 0)
    ORDER BY p.nombre ASC
  `;

  porCategoria = categorias.map((c: any) => ({
    ...c,
    items: productos.filter((p: any) => p.categoria_id === c.id),
  })).filter((c: any) => c.items.length > 0);
} catch (e) {
  cartaError = true;
}

function formatCLP(n: number) { return '$' + n.toLocaleString('es-CL'); }
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Carta de La Cascada — lista para imprimir y exhibir en mesa." />
    <title>Carta — La Cascada</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />
  </head>
  <body style="background-color: var(--color-surface-dark);">

    {cartaError ? (
      <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:2rem;">
        <div>
          <h1 style="font-family:var(--font-display);font-size:1.5rem;color:var(--color-primary);margin-bottom:0.5rem;">Carta temporalmente no disponible</h1>
          <p style="color:var(--color-text-muted);font-size:0.875rem;">Estamos teniendo problemas técnicos. Intenta nuevamente en unos minutos.</p>
        </div>
      </div>
    ) : (
    <!-- Barra de acciones (solo pantalla) -->
    <div class="no-print sticky top-0 z-10 px-4 py-3 flex items-center justify-between" style="background-color: var(--color-primary);">
      <p class="text-white text-sm font-medium">Vista previa de la carta</p>
      <button onclick="window.print()" class="px-5 py-2 rounded-full text-sm font-bold text-white transition-all" style="background-color: var(--color-accent);">
        🖨️ Imprimir / Guardar PDF
      </button>
    </div>

    <!-- Hoja A4 -->
    <div class="sheet mx-auto relative" style="background-color: var(--color-background);">

      <!-- Encabezado -->
      <header class="relative text-center pt-7 pb-4 px-10">
        <!-- QR en la esquina superior derecha -->
        <div class="qr-corner absolute text-center">
          <div class="rounded-2xl p-2 inline-block" style="background-color: #fff; border: 1.5px solid var(--color-border);">
            <img src="/assets/qr-menu-lacascada.png" alt="QR Menú Digital La Cascada" class="w-16 h-16 mx-auto" />
            <p class="text-[9px] font-bold mt-1 tracking-wide uppercase" style="color: var(--color-primary);">Escanea aquí</p>
            <p class="text-[8px] mt-0.5" style="color: var(--color-text-muted);">y pide desde tu mesa</p>
          </div>
        </div>

        <img src="/lacascadapro.png" alt="Logo La Cascada" class="w-24 h-24 mx-auto mb-2" />
        <h1 class="font-display text-3xl font-bold tracking-tight" style="color: var(--color-primary);">La Cascada</h1>
        <div class="flex items-center justify-center gap-3 mt-1.5">
          <div class="h-px w-10" style="background: linear-gradient(90deg, transparent, var(--color-accent));"></div>
          <span class="text-[10px] tracking-[0.3em] uppercase font-semibold" style="color: var(--color-accent);">Carta</span>
          <div class="h-px w-10" style="background: linear-gradient(90deg, var(--color-accent), transparent);"></div>
        </div>
        <p class="text-[11px] mt-1.5" style="color: var(--color-text-muted);">Rioseco #267, Lebu &middot; +569 66937327</p>
      </header>

      <!-- Categorías y productos -->
      <main class="px-10 pb-16">
        {porCategoria.map((cat: any) => (
          <section class="mb-4 break-inside-avoid">
            <h2 class="font-display text-lg font-bold pb-1 mb-2.5 border-b-2" style="color: var(--color-primary); border-color: var(--color-primary);">
              {cat.nombre}
            </h2>
            <ul class="space-y-2">
              {cat.items.map((p: any) => (
                <li class="break-inside-avoid">
                  <div class="flex items-baseline gap-2">
                    <span class="font-semibold text-sm" style="color: var(--color-text);">{p.nombre}</span>
                    <span class="flex-1 border-b border-dotted translate-y-[-4px]" style="border-color: var(--color-text-light);"></span>
                    <span class="font-bold text-sm whitespace-nowrap" style="color: var(--color-accent);">{formatCLP(p.precio)}</span>
                  </div>
                  {p.descripcion && (
                    <p class="text-[11px] mt-0.5 pr-16 leading-snug" style="color: var(--color-text-muted);">{p.descripcion}</p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </main>

      <!-- Pie -->
      <footer class="absolute bottom-0 left-0 right-0 pb-4 px-10">
        <div class="flex items-center gap-3 justify-center opacity-60">
          <div class="h-px w-8" style="background: linear-gradient(90deg, transparent, var(--color-accent));"></div>
          <span class="font-display italic text-xs" style="color: var(--color-accent);">Sabores que fluyen, momentos que quedan</span>
          <div class="h-px w-8" style="background: linear-gradient(90deg, var(--color-accent), transparent);"></div>
        </div>
      </footer>
    </div>
    )}

    <style>
      * {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .sheet {
        max-width: 210mm;
        min-height: 297mm;
        box-shadow: var(--shadow-xl);
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
      }
      .qr-corner {
        right: 2.5rem;
        top: 1.75rem;
      }
      @page {
        size: A4;
        margin: 0;
      }
      @media print {
        body { background-color: #fff !important; }
        .no-print { display: none !important; }
        .sheet {
          box-shadow: none;
          margin: 0;
          max-width: none;
          width: 210mm;
          min-height: 297mm;
        }
        .break-inside-avoid { break-inside: avoid; }
      }
    </style>
  </body>
</html>
