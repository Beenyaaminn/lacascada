---
import '../styles/global.css';
import { getSessionFromCookie } from '../lib/auth';

export interface Props {
  title?: string;
  currentPage?: string;
}

const { title = 'La Cascada - Panel', currentPage = '' } = Astro.props;

const cookieHeader = Astro.request.headers.get('cookie');
const session = getSessionFromCookie(cookieHeader);

interface MenuSection {
  label: string;
  icon: string;
  items: MenuItem[];
}

interface MenuItem {
  label: string;
  href: string;
  icon: string;
}

const isAdmin = session?.rol === 'admin';

const operacionesItems: MenuItem[] = [
  { label: 'Abrir Caja', href: '/admin/caja?accion=abrir', icon: '🔓' },
  { label: 'Cerrar Caja', href: '/admin/caja?accion=cerrar', icon: '🔒' },
  { label: 'Registro Contable', href: '/admin/stock?tab=contabilidad', icon: '📒' },
];

const adminExtras: MenuItem[] = isAdmin ? [
  { label: 'Usuarios', href: '/admin/usuarios', icon: '🔑' },
] : [];

const restauranteItems: MenuItem[] = [
  { label: 'Toma de Pedidos', href: '/admin/mesas', icon: '🍽️' },
  { label: 'Cocina', href: '/admin/cocina', icon: '👨‍🍳' },
  { label: 'Pedidos', href: '/admin/pedidos', icon: '📦' },
  { label: 'Productos', href: '/admin/productos', icon: '📋' },
  ...(isAdmin ? [{ label: 'Créditos', href: '/admin/clientes', icon: '👥' }] : []),
  ...adminExtras,
];

const allMenuSections: MenuSection[] = [
  { label: 'Restaurante', icon: '🍽️', items: restauranteItems },
  { label: 'Operaciones', icon: '🔧', items: operacionesItems },
  {
    label: 'Reportes', icon: '📊', items: [
      { label: 'Historial de Clientes', href: '/admin/reportes?tab=clientes', icon: '👤' },
      { label: 'Resumen de ventas', href: '/admin/reportes?tab=ventas', icon: '💰' },
      { label: 'Indicadores', href: '/admin/reportes?tab=indicadores', icon: '📈' },
      { label: 'Venta Jerarquías', href: '/admin/reportes?tab=jerarquias', icon: '🏢' },
      { label: 'Reportes delivery', href: '/admin/reportes?tab=delivery', icon: '🛵' },
    ],
  },
  {
    label: 'Stock Control', icon: '📦', items: [
      { label: 'Proveedores', href: '/admin/stock', icon: '🏭' },
      { label: 'Jerarquía de bodegas', href: '/admin/stock?tab=bodegas', icon: '🏗️' },
      { label: 'Contabilidad', href: '/admin/stock?tab=contabilidad', icon: '📒' },
    ],
  },
];

const menuSections = isAdmin ? allMenuSections : allMenuSections.filter(s => s.label === 'Restaurante' || s.label === 'Operaciones');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content="Panel de Administración - La Cascada" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex" style="background-color: var(--color-background);">
    <!-- Mobile overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 z-30 hidden lg:hidden" style="background-color: rgba(26, 20, 16, 0.6);" onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); this.classList.add('hidden')"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="w-64 flex flex-col shrink-0 min-h-screen overflow-y-auto fixed lg:relative z-40 inset-y-0 left-0 transition-transform duration-300 -translate-x-full lg:translate-x-0" style="background: linear-gradient(180deg, #1a1410 0%, #2d2418 100%); border-right: 1px solid rgba(201, 162, 39, 0.15);">
      <!-- Mobile close -->
      <button class="lg:hidden absolute top-3 right-3 text-xl p-1" style="color: #b9a690;" onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); document.getElementById('sidebar-overlay').classList.add('hidden')">&times;</button>

      <!-- Brand -->
      <div class="px-5 py-5" style="border-bottom: 1px solid rgba(201, 162, 39, 0.15);">
        <a href="/admin" class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #c9a227 0%, #a8841c 100%); box-shadow: 0 2px 8px rgba(201, 162, 39, 0.3);">
            <span class="font-display text-white font-bold text-sm">LC</span>
          </div>
          <div>
            <h1 class="font-display text-base font-bold" style="color: #f5efe4;">La Cascada</h1>
            <p class="text-[10px] tracking-[0.2em] uppercase" style="color: #c9a227;">Panel</p>
          </div>
        </a>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
        {menuSections.map((section) => {
          const isExpanded = section.items.some(item => currentPage.startsWith(item.href));
          return (
            <div class="mb-1">
              <button
                class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-left transition-colors"
                style="color: #d4c5a8;"
                onmouseover="this.style.color='#f5efe4';this.style.backgroundColor='rgba(201, 162, 39, 0.08)'"
                onmouseout="this.style.color='#d4c5a8';this.style.backgroundColor='transparent'"
                onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('.chevron').classList.toggle('rotate-90')"
              >
                <span>{section.icon}</span>
                <span class="flex-1">{section.label}</span>
                {section.items.length > 0 && (
                  <svg class={`chevron w-4 h-4 transition-transform ${isExpanded ? 'rotate-90' : ''}`} style="color: #8a7a68;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                )}
              </button>
              {section.items.length > 0 && (
                <div class={`mt-0.5 space-y-0.5 ${isExpanded ? '' : 'hidden'}`}>
                  {section.items.map((item) => {
                    const isActive = currentPage === item.href;
                    return (
                      <a
                        href={item.href}
                        class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm ml-4 transition-colors"
                        style={isActive
                          ? 'background-color: #c9a227; color: #1a1410; font-weight: 500;'
                          : 'color: #b9a690;'}
                        onmouseover={!isActive ? "this.style.color='#f5efe4';this.style.backgroundColor='rgba(201, 162, 39, 0.08)'" : ''}
                        onmouseout={!isActive ? "this.style.color='#b9a690';this.style.backgroundColor='transparent'" : ''}
                      >
                        <span>{item.icon}</span>
                        <span>{item.label}</span>
                      </a>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- User + Logout -->
      {session && (
        <div class="px-4 py-3" style="border-top: 1px solid rgba(201, 162, 39, 0.15);">
          <div class="flex items-center gap-2.5 mb-3">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold shrink-0" style="background: linear-gradient(135deg, #c9a227 0%, #a8841c 100%); color: #1a1410;">
              {session.nombre.charAt(0).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate" style="color: #f5efe4;">{session.nombre}</p>
              <p class="text-[10px] tracking-wider uppercase" style="color: #c9a227;">{session.rol}</p>
            </div>
          </div>
          <form action="/api/auth/logout" method="POST">
            <button type="submit" class="w-full text-xs py-1.5 px-3 rounded-md transition-colors" style="color: #b9a690; background-color: transparent; border: 1px solid rgba(201, 162, 39, 0.2);" onmouseover="this.style.color='#f5efe4';this.style.borderColor='rgba(201, 162, 39, 0.4)'" onmouseout="this.style.color='#b9a690';this.style.borderColor='rgba(201, 162, 39, 0.2)'">
              Cerrar Sesión
            </button>
          </form>
        </div>
      )}
    </aside>

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto w-full lg:w-auto">
      <!-- Mobile hamburger -->
      <button class="lg:hidden fixed top-3 left-3 z-20 p-2 rounded-lg shadow-lg" style="background: #1a1410; color: #f5efe4;" onclick="document.getElementById('sidebar').classList.remove('-translate-x-full'); document.getElementById('sidebar-overlay').classList.remove('hidden')">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <slot />
    </main>
  </body>
</html>

<style>
  .rotate-90 { transform: rotate(90deg); }
</style>
