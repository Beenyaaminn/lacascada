---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'La Cascada', description = 'Restaurante La Cascada — Cocina honesta, sabores que quedan. Est. 2014.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="theme-color" content="#205C66" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/lacascadapro.png" />
    <meta property="og:site_name" content="La Cascada" />
    <meta property="og:locale" content="es_CL" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/lacascadapro.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Public header (subtle) -->
    <header class="w-full px-6 py-4 flex items-center justify-between" style="background-color: var(--color-background); border-bottom: 1px solid var(--color-border-light);">
      <a href="/" class="flex items-center gap-3 no-underline group">
        <div class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-105" style="background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-soft) 100%); box-shadow: 0 2px 8px rgba(32, 92, 102, 0.3);">
          <span class="font-display text-white font-bold text-sm">LC</span>
        </div>
        <div>
          <span class="font-display text-base font-semibold" style="color: var(--color-primary);">La Cascada</span>
          <span class="text-[10px] tracking-[0.2em] uppercase ml-2 hidden sm:inline" style="color: var(--color-text-light);">Est. 2014</span>
        </div>
      </a>
      <nav class="flex items-center gap-1 sm:gap-2">
        <a href="/menu" class="nav-link">Carta</a>
        <a href="/delivery" class="nav-link">Delivery</a>
        <a href="/login" class="nav-link">Login</a>
      </nav>
    </header>
    <div class="flex-1 flex flex-col">
      <slot />
    </div>
  </body>
</html>

<style>
  .nav-link {
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .nav-link:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-dark);
  }
</style>
