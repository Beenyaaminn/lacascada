# ============================================================
# La Cascada - Variables de Entorno
# ============================================================

# Neon Serverless PostgreSQL (recomendado para produccion)
# 1. Crea un proyecto en https://neon.tech
# 2. Copia la URL de conexion con pooling (usa el endpoint -pooler):
#    postgresql://user:password@ep-xxxxx-pooler.us-east-2.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxxx-pooler.us-east-2.aws.neon.tech/db?sslmode=require

# REQUERIDO - Genera uno con: openssl rand -hex 32
JWT_SECRET=generar-con-openssl-rand-hex-32
